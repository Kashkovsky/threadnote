load("//tools/bazel:package_files.bzl", "export_package_files")

package(default_visibility = ["//visibility:public"])

export_package_files(["**"])

filegroup(
    name = "runtime",
    srcs = glob([
        "code-graph/**",
        "models/**",
    ]),
)

filegroup(
    name = "brand",
    srcs = glob(["brand/**"]),
)

filegroup(
    name = "all",
    srcs = [
        ":brand",
        ":runtime",
    ],
)
