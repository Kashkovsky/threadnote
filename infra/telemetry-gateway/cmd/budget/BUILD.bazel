load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools/bazel:package_files.bzl", "export_package_files")

export_package_files(["**"])

go_library(
    name = "budget_lib",
    srcs = ["main.go"],
    importpath = "github.com/Kashkovsky/threadnote/infra/telemetry-gateway/cmd/budget",
    visibility = ["//visibility:private"],
    deps = ["//infra/telemetry-gateway/internal/budget"],
)

go_binary(
    name = "budget",
    embed = [":budget_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "budget_test",
    srcs = ["main_test.go"],
    embed = [":budget_lib"],
)
