      "description": "Slowest operation wall-time p50, p95, and p99 values across the selected window from the bounded numeric threadnote.duration_ms attribute. Long-lived MCP process lifecycles and OTLP span duration are intentionally excluded.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "ms"
        },
        "overrides": []
      },
