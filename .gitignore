.DS_Store
# Checkout-local extra graph excludes; keep uncommitted.
.threadnoteignore.local
node_modules/
dist/
# Bun may leave a root-level compiler intermediate during standalone builds.
/.*.bun-build
site-dist/
build/
# These are source namespaces, not generated build output.
!packages/graph/src/build/
!packages/graph/src/build/**
!packages/graph/src/store/build/
!packages/graph/src/store/build/**
out/
coverage/
artifacts/
.artifacts/
.target-builds/
*.log
manager/app.js
CLAUDE.md
.claude/settings.json
.codex/hooks.json
.context
.venv/
.pytest_cache/
__pycache__/
*.pyc

# Internal design records are preserved as shared Threadnote durable memories.
docs/4.0-plan.md
docs/**/architecture.md
docs/**/*-architecture.md
docs/effect.md
docs/**/*-implementation-plan.md
docs/**/adr/

# Bazel output symlinks; action state lives outside source.
/bazel-*

# Explicit Git-aware website metadata input, regenerated per checkout.
/apps/website/.bazel-inputs/
