+func TestWalkRouteWithHandlerAndSubrouter(t *testing.T) {
+	r := NewRouter()
+	handler := func(w http.ResponseWriter, req *http.Request) {}
+
+	r.Route("/foo", func(r Router) {
+		r.Route("/bar", func(r Router) {
+			r.Get("/{id}", handler)
+		})
+		r.Get("/bar", handler)
+	})
+
+	var routes []string
+	if err := Walk(r, func(method, route string, _ http.Handler, _ ...func(http.Handler) http.Handler) error {
+		routes = append(routes, method+" "+route)
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+
+	for _, want := range []string{"GET /foo/bar", "GET /foo/bar/{id}"} {
+		found := false
+		for _, route := range routes {
+			if route == want {
+				found = true
+				break
+			}
+		}
+		if !found {
+			t.Errorf("Walk missing %q in %v", want, routes)
+		}
+	}
+}
